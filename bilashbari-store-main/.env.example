# Frontend settings
# Local dev only. On Vercel set VITE_API_URL=/api instead.
VITE_API_URL=http://localhost:5000/api

# Backend server
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# MySQL connection (plain mysql2 - no ORM, no Vercel Storage)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bilashbari

# Optional: hosted providers (Railway, Aiven, Clever Cloud, ...) hand out a single
# connection string. If set it is used instead of the individual DB_* vars above.
# MYSQL_URL=mysql://user:password@host:3306/bilashbari
# DB_SSL=true            # enable TLS - managed MySQL usually requires it
# DB_SSL_NO_VERIFY=true  # only if the provider uses a self-signed certificate
