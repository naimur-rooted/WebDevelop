PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=bilashbari
JWT_SECRET=your_jwt_secret
CORS_ORIGIN=http://localhost:5173

# Optional: hosted providers give one connection string instead of the DB_* vars.
# An explicit DB_* variable above still wins over the matching part of the URL.
# MYSQL_URL=mysql://user:password@host:3306/bilashbari
# DB_SSL=true            # enable TLS (managed MySQL usually needs it)
# DB_SSL_NO_VERIFY=true  # only if the provider uses a self-signed certificate

