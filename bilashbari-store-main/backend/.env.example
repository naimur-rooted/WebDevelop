PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=bilashbari
JWT_SECRET=your_jwt_secret
CORS_ORIGIN=http://localhost:5173

# Optional: hosted providers (Aiven, TiDB Cloud, Railway, ...) hand out a single
# connection string as a shortcut. An explicit DB_* variable above always wins over
# the matching part of the URL, so you can correct one field without editing the URL.
# MYSQL_URL=mysql://user:password@host:3306/bilashbari?ssl-mode=REQUIRED
# DB_SSL=true            # enable TLS - managed MySQL usually requires it
# DB_SSL_NO_VERIFY=true  # only if the provider uses a self-signed certificate
# DB_CREATE_DATABASE=0   # set when the user may not run CREATE DATABASE
# DB_COLLATION=utf8mb4_general_ci  # only for MySQL-compatible servers
#                                  # (e.g. TiDB) that reject utf8mb4_unicode_ci

