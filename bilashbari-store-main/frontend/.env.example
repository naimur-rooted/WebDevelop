# Frontend build-time settings.
# VITE_* variables are baked into the bundle at `vite build` time -
# changing them requires a rebuild (Render -> Manual Deploy works too).

# Local dev: backend running via `npm run dev` inside backend/
VITE_API_URL=http://localhost:5000/api

# Production: point at the Render Web Service (remove the # and adjust the name):
# VITE_API_URL=https://bilashbari-api.onrender.com/api

# Database / JWT / CORS variables live in backend/.env.example - the static
# frontend never talks to MySQL directly.

